# ---------------------------------------------------------------------------
# Database (Postgres). Both variables are required.
#
# DATABASE_URL is the pooled connection the running app uses. On a serverless
# host every function invocation can open its own connection, so this should
# point at a connection pooler (Neon's "-pooler" host, Supabase port 6543, or
# a PgBouncer in front of your own Postgres).
#
# DIRECT_URL is the direct, unpooled connection. Prisma uses it for migrations,
# which a transaction pooler cannot run. If your provider does not distinguish
# the two, set both to the same string.
#
# Never commit real credentials. These are placeholders.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host-pooler.example.com/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.example.com/dbname?sslmode=require"

# Optional: override the CS2 skin data source used by `npm run data:fetch`.
# Defaults to the public, no-auth-required ByMykel/CSGO-API dataset.
SKIN_DATA_SOURCE_URL="https://raw.githubusercontent.com/ByMykel/CSGO-API/main/public/api/en/skins.json"

# Optional: override the agent portrait dataset used by `npm run seed:agents`.
AGENT_DATA_SOURCE_URL="https://raw.githubusercontent.com/ByMykel/CSGO-API/main/public/api/en/agents.json"
