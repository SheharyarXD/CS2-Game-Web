# Database connection string used by Prisma.
# Local development default (SQLite, zero setup):
DATABASE_URL="file:./prisma/dev.db"

# Production example (Postgres via Neon/Supabase/Railway) — see README "Switching to Postgres":
# DATABASE_URL="postgresql://user:password@host:5432/cs2_guessing_game?schema=public"

# Optional: override the CS2 skin data source used by `npm run data:fetch`.
# Defaults to the public, no-auth-required ByMykel/CSGO-API dataset.
SKIN_DATA_SOURCE_URL="https://raw.githubusercontent.com/ByMykel/CSGO-API/main/public/api/en/skins.json"
