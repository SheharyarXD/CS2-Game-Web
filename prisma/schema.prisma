// CS2 Guessing Game — data model.
//
// Postgres, in both development and production. The app is deployed to
// Vercel, whose functions have no persistent filesystem, so a file-based
// database is not an option there; running the same engine locally keeps
// dev and production honest about each other.
//
// The schema deliberately avoids Prisma enums and case-insensitive
// filters, which is a holdover from the earlier SQLite setup and costs
// nothing to keep.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection, used by the app at runtime. On serverless every
  // invocation can open its own connection, so this should point at a
  // pooler (Neon's -pooler host, Supabase's port 6543, or PgBouncer).
  url       = env("DATABASE_URL")
  // Direct, unpooled connection. Prisma uses this for migrations, which
  // a transaction pooler cannot run. Falls back to DATABASE_URL when the
  // provider does not distinguish the two.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Skins
// ---------------------------------------------------------------------------

model Skin {
  id           String   @id // stable slug derived from the source dataset id
  name         String // e.g. "Redline"
  weapon       String // e.g. "AK-47"
  displayName  String // e.g. "AK-47 | Redline"
  imageUrl     String
  rarity       String // normalized rarity key, see lib/game/rarityMatching.ts
  // The container the skin was FIRST released in. A Rare Special Item can
  // drop from several cases over the years (Butterfly Knife | Lore is in
  // both Operation Riptide and Dreams & Nightmares); this always holds the
  // earliest. See scripts/lib/normalizeSkin.ts#pickOriginalRelease.
  caseOrCollection String? // display name of that original case/collection
  caseType     String? // "case" | "collection" | null (no known source)
  sourceContainerId String? // upstream id of the original container, for auditing
  releaseDate  DateTime? // when that original container first shipped
  releaseYear  Int? // year of releaseDate, denormalized for the Year comparison
  // Every non-souvenir container the skin appears in, JSON-encoded
  // [{id,name,type,releaseDate}]. Kept so the original-release choice can
  // be re-derived or audited without a re-import; gameplay only ever uses
  // the canonical fields above.
  containers   String   @default("[]")
  color        String // dominant colour derived from the skin render (clue only; never compared)
  colorSource  String // "image" | "fallback" — how `color` was derived (documents provenance)
  weaponCategory String @default("rifle") // weapon family, see lib/game/weaponMatching.ts
  // Lowercased "weapon | name" used for case-insensitive search. Prisma's
  // `mode: "insensitive"` filter only works on Postgres/MySQL, not SQLite —
  // this column keeps search portable across both providers.
  searchText   String
  isKnife      Boolean  @default(false)
  isGlove      Boolean  @default(false)
  hasStatTrak  Boolean  @default(false) // whether a StatTrak(TM) variant exists (not a separate entry)
  active       Boolean  @default(true) // set false to retire a skin from rotation without deleting history
  popularity   Int      @default(0) // higher = more likely to be picked; also used to curate the pool
  sourceId     String // original id from the upstream dataset, for re-import/debugging
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dailyGames   DailySkinGame[]
  gameSessions GameSession[]

  @@index([active])
  @@index([weapon])
  @@index([rarity])
  @@index([releaseYear])
  @@index([searchText])
}

// ---------------------------------------------------------------------------
// Maps
// ---------------------------------------------------------------------------

model GameMap {
  id            String   @id // slug, e.g. "dust2"
  name          String // display name, e.g. "Dust II"
  imageUrl      String
  imageWidth    Int
  imageHeight   Int
  // Focal point (0-100, percent of image dimensions) the zoomed-in reveal
  // centers on. Defaults to dead center; override per map to start the
  // reveal on a more recognizable landmark.
  focalX        Int      @default(50)
  focalY        Int      @default(50)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gameSessions  GameSession[]

  @@index([active])
}

// ---------------------------------------------------------------------------
// Daily challenge — one deterministic row per UTC calendar day.
// Pre-materializing the day's target (instead of only hashing on the fly)
// lets us guarantee an even rotation with no immediate repeats. See
// lib/game/dailyTarget.ts for the selection algorithm.
// ---------------------------------------------------------------------------

model DailySkinGame {
  id        String   @id @default(cuid())
  dateKey   String   @unique // UTC calendar date, "YYYY-MM-DD"
  skinId    String
  skin      Skin     @relation(fields: [skinId], references: [id])
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Game sessions — server-authoritative state for both skin and map modes.
// The target id is NEVER serialized to the client until the game ends.
// ---------------------------------------------------------------------------

// `mode` and `status` are plain strings rather than Prisma enums, a
// holdover from the earlier SQLite setup that costs nothing to keep. Valid
// values are enforced at the application layer via the GameMode/GameStatus
// TS unions in src/lib/game/types.ts — the same pattern used for rarity
// and colour.
model GameSession {
  id            String     @id @default(cuid())
  sessionToken  String // anonymous player identifier, from a signed httpOnly cookie
  mode          String // "DAILY_SKIN" | "UNLIMITED_SKIN" | "MAP"
  dateKey       String? // set only for DAILY_SKIN, ties the session to one calendar day

  targetSkinId  String?
  targetSkin    Skin?      @relation(fields: [targetSkinId], references: [id])
  targetMapId   String?
  targetMap     GameMap?   @relation(fields: [targetMapId], references: [id])

  status        String     @default("IN_PROGRESS") // "IN_PROGRESS" | "WON" | "LOST"
  cluesUsed     String     @default("[]") // JSON-encoded string[] of clue keys revealed so far
  startedAt     DateTime   @default(now())
  completedAt   DateTime?

  guesses       GameGuess[]

  @@unique([sessionToken, mode, dateKey])
  @@index([sessionToken])
}

model GameGuess {
  id            String      @id @default(cuid())
  sessionId     String
  session       GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guessOrder    Int // 1-indexed attempt number within the session
  guessedSkinId String?
  guessedMapId  String?
  result        String // JSON-encoded ComparisonResult (skin) or {correct: boolean} (map)
  createdAt     DateTime    @default(now())

  @@unique([sessionId, guessOrder])
}

// ---------------------------------------------------------------------------
// Per-player stats, shown in the sidebar. Keyed by the same anonymous
// session cookie as GameSession — real, server-computed numbers, never
// fabricated in the UI. See lib/server/playerStats.ts.
// ---------------------------------------------------------------------------

model PlayerStats {
  sessionToken      String   @id
  gamesPlayed       Int      @default(0) // completed sessions across all modes, lifetime
  dailyStreak       Int      @default(0) // consecutive UTC days the daily skin was solved
  lastDailyDateKey  String? // last "YYYY-MM-DD" the daily was solved on
  daysPlayed        Int      @default(0) // distinct UTC days with at least one guess
  lastActiveDateKey String? // last "YYYY-MM-DD" any guess was made on

  // Profile levelling. `gamesTowardLevel` resets when the player reaches
  // max level and is awarded that year's service medal; see
  // lib/game/playerRank.ts.
  gamesTowardLevel  Int      @default(0)
  serviceMedals     String   @default("[]") // JSON-encoded number[] of years earned

  // Chosen agent avatar (Agent.id), null until the player picks one.
  agentId           String?
  agent             Agent?   @relation(fields: [agentId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Playable agent portraits offered in the profile picture picker. Imported
// from the same upstream dataset as the skins — see scripts/seed-agents.ts.
// ---------------------------------------------------------------------------

model Agent {
  id        String   @id
  name      String // full name including the collection suffix
  shortName String // name without the " | Collection" suffix
  imageUrl  String
  team      String // "Terrorist" | "Counter-Terrorist"
  rarity    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players   PlayerStats[]

  @@index([active])
}
